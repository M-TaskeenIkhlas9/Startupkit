# Same shape as .env.production.example, pointed at staging infra/keys.
ENV=staging
NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com

POSTGRES_USER=startupkit
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_DB=startupkit
DATABASE_URL=postgresql://startupkit:replace-with-a-real-password@postgres:5432/startupkit

ANTHROPIC_API_KEY=
