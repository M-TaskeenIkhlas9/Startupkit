# ---- Core ----
ENV=development
APP_BASE_URL=http://localhost:3000

# ---- Postgres (Company DB + Event store + Outbox) ----
DATABASE_URL=postgresql://startupkit:startupkit@localhost:5432/startupkit

# ---- Temporal (durable execution, Python SDK) ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ---- Field encryption (PII + provider tokens) ----
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---- Model provider (Document Intelligence) ----
ANTHROPIC_API_KEY=

# ---- Example provider creds (per-tenant in prod; local dev only here) ----
MERCURY_API_KEY=
DOCUSIGN_API_KEY=
